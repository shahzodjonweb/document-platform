  },
  "close": {
   "uz": "Hurmat bilan,",
   "ru": "С уважением,",
   "en": "Yours faithfully,"
  },
  "enclosure": {
   "uz": "Ilova:",
   "ru": "Приложение:",
   "en": "Enclosure:"
  },
  "enclosures": {
   "uz": "Ilova:",
   "ru": "Приложение:",
   "en": "Enclosures:"
