    "budget_total"
   ],
   "params": {
    "figures": [
     {
      "field": "budget_total",
      "label": "kf_budget"
     }
    ],
    "from": "goals",
    "value_column": 2,
    "compare_column": 1,
    "compare_label": "kf_now",
    "label_suffix": "kf_goal",
    "boxes": 4,
    "min": 1
   }
  },
  {
   "block": "heading",
   "part": "goals",
   "params": {
    "level": 1,
    "numbering": "decimal",
    "rule": "under"
   }
  },
  {
   "block": "table",
   "part": "goals",
   "params": {
    "columns": [
     {
      "width_mm": "flex"
     },
     {
      "width_mm": 20,
      "type": "number"
     },
     {
      "width_mm": 22,
      "type": "number"
     },
     {
      "width_mm": 28
     },
     {
      "width_mm": 36
     }
    ],
    "rules": "horizontal",
    "drop_empty_columns": true
   },
   "when": "part:goals"
  },
  {
   "block": "table",
