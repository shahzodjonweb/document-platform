    "approver"
   ],
   "params": {
    "word": "approved",
    "rows": [
     "approver"
    ],
    "date": true,
    "year": "blank",
    "side": "right"
   }
  },
  {
   "block": "doc_head",
   "part": "plan_head",
   "fields": [
    "business_name",
    "period"
   ],
   "params": {
    "overline": "business_name",
    "kind_default": "kind",
    "title": "title",
    "subtitle": [
     "period"
    ],
    "align": "left",
    "rules": "below"
   }
  },
  {
   "block": "toc",
   "part": "toc",
   "when": "pages_from:10",
   "params": {
    "label": "toc",
    "levels": 1
   }
  },
  {
