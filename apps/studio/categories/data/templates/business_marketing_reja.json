{
 "schema": 2,
 "id": "business_marketing_reja",
 "entries": [
  "pdf.biz.marketing_reja"
 ],
 "name": {
  "uz": "Marketing reja",
  "ru": "Маркетинг-план",
  "en": "Marketing plan"
 },
 "family": "business",
 "page": {
  "margins_mm": {
   "left": 30,
   "right": 15,
   "top": 26,
   "bottom": 20
  }
 },
 "type": {
  "face": "sans",
  "ladder": [
   [
    10.5,
    15.5
   ],
   [
    10,
    14.8
   ],
   [
    9.5,
    14
   ]
  ],
  "align": "left"
 },
 "page_rule": {
  "kind": "flow"
 },
 "furniture": {
  "first": "none",
  "later": "header_number",
  "format": "n",
  "header": [
   "business_name",
   "period"
  ]
 },
 "flow": [
  {
   "block": "approval_block",
   "part": "approval",
   "when": "fact:approver",
   "fields": [
    "approver"
   ],
   "params": {
    "label": "approved",
    "anchor": "right_half"
   }
  },
  {
   "block": "title_page",
   "part": "title_page",
   "when": "pages_from:8",
   "fields": [
    "business_name",
    "location",
    "author",
    "period"
   ],
   "params": {
    "label": "kind",
    "title": "content_title",
    "labels": {
     "business_name": "row_business",
     "location": "row_area",
     "author": "row_author"
    }
   }
  },
  {
   "block": "doc_head",
   "part": "plan_head",
   "fields": [
    "business_name",
    "period"
   ],
   "params": {
    "overline": "business_name",
    "kind_line": "kind",
    "title": "content_title",
    "subtitle": [
     "period"
    ],
    "captions": {
     "period": "cap_period"
    }
   }
  },
  {
   "block": "toc",
   "part": "toc",
   "when": "pages_from:10",
   "params": {
    "label": "toc",
    "levels": 1
   }
  },
  {
   "block": "heading",
   "part": "summary_text",
   "params": {
    "level": 1,
    "numbering": "chapter"
   }
  },
  {
   "block": "paragraph",
   "part": "summary_text"
  },
  {
   "block": "key_figures",
   "part": "summary_figures",
   "fields": [
    "budget_total",
    "current_state"
   ],
   "params": {
    "from": "goals",
    "boxes": 4,
    "labels": {
     "budget_total": "kf_budget"
    }
   }
  },
  {
   "block": "heading",
   "part": "goals",
   "params": {
    "level": 1,
    "numbering": "chapter"
   }
  },
  {
   "block": "table",
   "part": "goals",
   "params": {
    "drop_empty_columns": true
   }
  },
  {
   "block": "heading",
   "part": "competitors",
   "when": "part:competitors",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_market"
   }
  },
  {
   "block": "paragraph",
   "part": "market",
   "when": "part:market",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "table",
   "part": "competitors",
   "when": "part:competitors",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "card_grid",
   "part": "swot",
   "when": "part:swot",
   "params": {
    "heading": "section",
    "columns": 2,
    "labels": {
     "strengths": "sw_s",
     "weaknesses": "sw_w",
     "opportunities": "sw_o",
     "threats": "sw_t"
    }
   }
  },
  {
   "block": "heading",
   "part": "audience",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_audience"
   }
  },
  {
   "block": "paragraph",
   "part": "audience",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "callout",
   "part": "positioning",
   "when": "part:positioning",
   "params": {
    "heading": "section",
    "label": "position_run_in"
   }
  },
  {
   "block": "heading",
   "part": "channels",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_strategy"
   }
  },
  {
   "block": "list",
   "part": "mix",
   "when": "part:mix",
   "params": {
    "heading": "section",
    "run_in": true,
    "labels": {
     "product": "p_product",
     "price": "p_price",
     "place": "p_place",
     "promotion": "p_promotion"
    }
   }
  },
  {
   "block": "table",
   "part": "channels",
   "params": {
    "heading": "section",
    "note": "proposal_note"
   }
  },
  {
   "block": "heading",
   "part": "budget",
   "when": "part:budget",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_budget"
   }
  },
  {
   "block": "table",
   "part": "budget",
   "when": "part:budget",
   "params": {
    "heading": "section",
    "total_label": "total"
   }
  },
  {
   "block": "table",
   "part": "calendar",
   "when": "part:calendar",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "heading",
   "part": "review",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_review"
   }
  },
  {
   "block": "table",
   "part": "kpis",
   "when": "part:kpis",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "callout",
   "part": "review",
   "params": {
    "label": "review_run_in"
   }
  },
  {
   "block": "table",
   "part": "ch_risks",
   "when": "part:ch_risks",
   "params": {
    "heading": "chapter"
   }
  },
  {
   "block": "paragraph",
   "part": "ch_conclusion",
   "when": "part:ch_conclusion",
   "params": {
    "heading": "chapter"
   }
  },
  {
   "block": "signature_row",
   "part": "signature",
   "when": "fact:approver",
   "keep": "closing",
   "fields": [
    "author"
   ],
   "params": {
    "variant": "role_position_sign_name",
    "label": "prepared",
    "captions": {
     "author": "cap_position"
    }
   }
  }
 ],
