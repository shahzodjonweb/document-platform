    },
    "labels": {
     "phone": "tel",
     "email": "email"
    }
   }
  },
  {
   "block": "split_row",
   "part": "addressee_row",
   "fields": [
    "recipient_lines",
    "recipient_person",
    "letter_date"
   ],
   "params": {
    "left": {
     "block": "party_block",
     "fields": [
      "recipient_lines",
      "recipient_person"
     ],
     "anchor": "left",
     "max_lines": 4
    },
    "right": {
     "block": "date_line",
     "fact": "letter_date",
     "align": "right",
     "year": "clock"
    },
    "left_mm": 104
   }
  },
  {
   "block": "line",
   "part": "salutation",
   "fields": [
    "salutation"
   ],
