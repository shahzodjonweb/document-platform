   "params": {
    "text": "admissions"
   }
  },
  {
   "block": "line",
   "when": "fact:salutation_form=selection",
   "params": {
    "text": "selection"
   }
  },
  {
   "block": "line",
   "when": "fact:salutation_form=general",
   "params": {
    "text": "general"
   }
  },
  {
   "block": "line",
   "when": "nofact:salutation_form",
   "params": {
    "text": "general"
   }
  },
  {
   "block": "line",
   "part": "subject",
   "fields": [
    "target_programme",
    "target_institution",
    "intake"
   ],
   "params": {
    "label": "kind",
    "style": "bold",
    "max_lines": 3,
    "balance": true,
    "separator": ", "
   },
   "when": "fact:target_programme"
  },
  {
   "block": "line",
   "part": "subject",
   "fields": [
    "target_institution",
    "intake"
   ],
   "params": {
    "style": "bold",
    "max_lines": 3,
    "balance": true,
    "separator": ", "
   },
   "when": "nofact:target_programme"
  },
  {
   "block": "paragraph",
   "part": "opening",
   "params": {
    "gap_pt": 7,
    "before_pt": 7
   }
  },
  {
   "block": "paragraph",
   "part": "why",
   "when": "part:why",
   "params": {
    "gap_pt": 7,
    "before_pt": 7
   }
  },
  {
   "block": "paragraph",
   "part": "evidence",
   "when": "part:evidence",
   "params": {
    "gap_pt": 7,
    "before_pt": 7
   }
  },
  {
   "block": "paragraph",
   "part": "contribution_goals",
   "when": "part:contribution_goals",
   "params": {
    "gap_pt": 7,
    "before_pt": 7
   }
  },
  {
   "block": "paragraph",
   "part": "closing",
   "keep": "closing",
   "params": {
    "gap_pt": 7,
    "before_pt": 7
   }
  },
  {
   "block": "line",
   "part": "close",
   "when": "fact:salutation_form=person",
   "keep": "closing",
   "params": {
    "text": "close_named",
    "before_pt": 10
   }
  },
  {
   "block": "line",
   "part": "close",
   "when": "nofact:salutation_form=person",
   "keep": "closing",
   "params": {
    "text": "close",
    "before_pt": 10
   }
  },
  {
   "block": "line",
   "part": "close",
   "fields": [
    "applicant_name"
   ],
   "when": "fact:applicant_name",
   "keep": "closing",
   "params": {
    "before_pt": 30
   }
  },
  {
   "block": "ruled_blank",
   "fields": [
    "applicant_name"
   ],
   "when": "blank:applicant_name",
   "keep": "closing",
   "params": {
    "style": "captioned",
    "caption": "cap_name",
    "width_mm": 60,
    "indent_mm": 0,
    "pitch_pt": 36
   }
  },
  {
   "block": "list",
   "part": "enclosures",
   "when": "part:enclosures",
   "keep": "closing",
   "params": {
    "marker": "number",
    "label": "enclosure",
    "max_items": 6,
    "single_unnumbered": true
   }
  }
 ],
