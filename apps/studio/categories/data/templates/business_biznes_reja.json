{
 "schema": 2,
 "id": "business_biznes_reja",
 "entries": [
  "pdf.biz.biznes_reja"
 ],
 "name": {
  "uz": "Biznes-reja",
  "ru": "Бизнес-план",
  "en": "Business plan"
 },
 "family": "business",
 "page": {
  "margins_mm": {
   "left": 30,
   "right": 15,
   "top": 26,
   "bottom": 20
  }
 },
 "type": {
  "face": "sans",
  "ladder": [
   [
    10.5,
    15.5
   ],
   [
    10,
    14.8
   ],
   [
    9.5,
    14
   ]
  ],
  "align": "left"
 },
 "page_rule": {
  "kind": "count",
  "trim": false
 },
 "furniture": {
  "first": "none",
  "later": "header_number",
  "format": "n",
  "header": [
   "applicant",
   "project_name"
  ]
 },
 "flow": [
  {
   "block": "title_page",
   "part": "title_page",
   "when": "pages_from:4",
   "fields": [
    "project_name",
    "purpose",
    "applicant",
    "director",
    "address",
    "contacts",
    "location",
    "plan_year"
   ],
   "params": {
    "label": "kind",
    "title": "content_title",
    "foot": [
     "location",
     "plan_year"
    ],
    "labels": {
     "applicant": "row_applicant",
     "director": "row_director",
     "address": "row_address",
     "contacts": "row_contacts"
    }
   }
  },
  {
   "block": "toc",
   "part": "toc",
   "when": "pages_from:12",
   "params": {
    "label": "toc",
    "levels": 1
   }
  },
  {
   "block": "heading",
   "part": "summary_lead",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_summary"
   }
  },
  {
   "block": "paragraph",
   "part": "summary_lead"
  },
  {
   "block": "key_figures",
   "part": "summary_figures",
   "fields": [
    "own_funds",
    "external_funding"
   ],
   "params": {
    "from": "finance_investment",
    "labels": {
     "own_funds": "kf_own",
     "external_funding": "kf_external"
    },
    "label": "kf_investment"
   }
  },
  {
   "block": "heading",
   "part": "summary_details",
   "params": {
    "level": 2,
    "numbering": "section"
   }
  },
  {
   "block": "kv_table",
   "part": "summary_details",
   "fields": [
    "project_name",
    "applicant",
    "legal_form",
    "director",
    "tax_id",
    "address",
    "contacts",
    "tax_regime"
   ],
   "params": {
    "labels": {
     "project_name": "row_project",
     "applicant": "row_applicant",
     "legal_form": "row_legal_form",
     "director": "row_director",
     "tax_id": "row_tax_id",
     "address": "row_address",
     "contacts": "row_contacts",
     "tax_regime": "row_tax_regime"
    },
    "omit_missing": [
     "tax_regime"
    ]
   }
  },
  {
   "block": "heading",
   "part": "summary_purpose",
   "params": {
    "level": 2,
    "numbering": "section"
   }
  },
  {
   "block": "paragraph",
   "part": "summary_purpose"
  },
  {
   "block": "heading",
   "part": "summary_status",
   "when": "part:summary_status",
   "params": {
    "level": 2,
    "numbering": "section"
   }
  },
  {
   "block": "paragraph",
   "part": "summary_status",
   "when": "part:summary_status"
  },
  {
   "block": "heading",
   "part": "business_description",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_business"
   }
  },
  {
   "block": "paragraph",
   "part": "business_description"
  },
  {
   "block": "table",
   "part": "product",
   "when": "part:product",
   "params": {
    "numbered": true,
    "heading": "section"
   }
  },
  {
   "block": "heading",
   "part": "market_customers",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_market"
   }
  },
  {
   "block": "paragraph",
   "part": "market_customers"
  },
  {
   "block": "table",
   "part": "market_competitors",
   "when": "part:market_competitors",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "list",
   "part": "marketing",
   "when": "part:marketing",
   "params": {
    "marker": "bullet",
    "run_in": true,
    "heading": "section",
    "labels": {
     "price": "mk_price",
     "sales": "mk_sales",
     "promotion": "mk_promotion"
    }
   }
  },
  {
   "block": "heading",
   "part": "operations",
   "when": "part:operations",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_operations"
   }
  },
  {
   "block": "paragraph",
   "part": "operations",
   "when": "part:operations",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "table",
   "part": "team",
   "when": "part:team",
   "params": {
    "heading": "section",
    "total_label": "total"
   }
  },
  {
   "block": "table",
   "part": "schedule",
   "when": "part:schedule",
   "params": {
    "heading": "section",
    "drop_empty_columns": true
   }
  },
  {
   "block": "heading",
   "part": "finance_investment",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_finance"
   }
  },
  {
   "block": "table",
   "part": "finance_investment",
   "params": {
    "numbered": true,
    "heading": "section",
    "total_label": "total",
    "drop_empty_columns": true
   }
  },
  {
   "block": "table",
   "part": "finance_sources",
   "params": {
    "heading": "section",
    "total_label": "total"
   }
  },
  {
   "block": "kv_table",
   "part": "finance_terms",
   "when": "fact:purpose=loan",
   "fields": [
    "loan_bank",
    "external_funding",
    "loan_rate",
    "loan_term",
    "loan_grace",
    "loan_repayment",
    "loan_collateral"
   ],
   "params": {
    "heading": "section",
    "labels": {
     "loan_bank": "lt_bank",
     "external_funding": "lt_amount",
     "loan_rate": "lt_rate",
     "loan_term": "lt_term",
     "loan_grace": "lt_grace",
     "loan_repayment": "lt_repayment",
     "loan_collateral": "lt_collateral"
    },
    "omit_missing": [
     "loan_grace",
     "loan_repayment"
    ]
   }
  },
  {
   "block": "kv_table",
   "part": "finance_terms",
   "when": "fact:purpose=investor",
   "fields": [
    "external_funding",
    "investor_offer"
   ],
   "params": {
    "label": "investor_heading",
    "labels": {
     "external_funding": "inv_amount",
     "investor_offer": "inv_offer"
    }
   }
  },
  {
   "block": "table",
   "part": "finance_revenue",
   "when": "part:finance_revenue",
   "params": {
    "heading": "section",
    "total_label": "total_named"
   }
  },
  {
   "block": "table",
   "part": "finance_costs",
   "when": "part:finance_costs",
   "params": {
    "heading": "section",
    "total_label": "total_named"
   }
  },
  {
   "block": "table",
   "part": "finance_result",
   "when": "part:finance_result",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "heading",
   "part": "risks",
   "params": {
    "level": 1,
    "numbering": "chapter",
    "label": "ch_closing"
   }
  },
  {
   "block": "table",
   "part": "risks",
   "params": {
    "heading": "section"
   }
  },
  {
   "block": "heading",
   "part": "conclusion",
   "params": {
    "level": 2,
    "numbering": "section"
   }
  },
  {
   "block": "paragraph",
   "part": "conclusion",
   "keep": "closing"
  },
  {
   "block": "list",
   "part": "attachments",
   "when": "part:attachments",
   "keep": "closing",
   "params": {
    "marker": "number",
    "heading": "section"
   }
  },
  {
   "block": "signature_row",
   "part": "signature",
   "when": "nofact:purpose=own",
   "keep": "closing",
   "fields": [
    "signers",
    "director"
   ],
   "params": {
    "variant": "position_sign_name",
    "captions": {
     "signers": "cap_position",
     "director": "cap_name"
    }
   }
  },
  {
   "block": "line",
   "part": "signature",
   "when": "fact:stamp_request",
   "keep": "closing",
   "params": {
    "label": "seal",
    "style": "small"
   }
  }
 ],
