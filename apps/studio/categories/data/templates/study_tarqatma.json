  "margins_mm": {
   "left": 20,
   "right": 15,
   "top": 15,
   "bottom": 18
  }
 },
 "type": {
  "face": "serif",
  "ladder": [
   [
    11,
    15
   ],
   [
    10.5,
    14.5
   ],
   [
    10,
    13.8
   ]
  ],
  "align": "left"
 },
 "page_rule": {
  "kind": "count"
 },
