  "later": "header_number",
  "format": "n",
  "header": [
   "subject",
   "grade"
  ]
 },
 "flow": [
  {
   "block": "cell_strip",
   "part": "h_head",
   "fields": [
    "topic",
    "grade",
    "subject"
   ],
   "params": {
    "rows": [
     [
      {
       "label": "name",
       "share": 1
      }
     ],
     [
      {
       "label": "class",
       "share": 0.5
      },
      {
       "label": "date",
       "share": 0.5
      }
     ]
    ],
    "height_mm": 9
   }
  },
  {
   "block": "doc_head",
   "part": "h_head",
   "fields": [
    "topic",
    "grade",
    "subject"
   ],
   "params": {
    "overline": "overline",
    "title": [
     "topic"
    ],
    "subtitle": [
     "grade",
     "subject"
    ],
    "rules": "above"
   }
  },
  {
   "block": "callout",
   "part": "h_rule",
   "when": "part:h_rule",
   "params": {
    "style": "bar"
   }
  },
  {
   "block": "heading",
   "part": "task",
   "when": "part:task",
   "params": {
    "level": 3,
    "numbering": "arabic",
    "style": "badge"
   }
  },
  {
   "block": "list",
   "part": "task",
   "when": "part:task",
   "params": {
    "marker": "number"
   }
  },
  {
   "block": "heading",
   "part": "h_key",
   "when": "part:h_key",
   "params": {
    "level": 3,
    "caps": true
   },
   "page_break_before": true
  },
  {
   "block": "line",
   "part": "h_key",
   "when": "part:h_key",
   "params": {
    "text": "teacher_only",
    "style": "italic"
   }
  },
  {
   "block": "kv_table",
   "part": "h_key",
   "when": "part:h_key",
   "params": {
    "rows": "h_key"
   }
  }
 ],
