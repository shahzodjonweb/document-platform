{
 "schema": 2,
 "entries": [
  "pdf.test"
 ],
 "id": "study_test",
 "name": {
  "uz": "Test varag‘i",
  "ru": "Тестовый лист",
  "en": "Test paper"
 },
 "family": "study",
 "page": {
  "margins_mm": {
   "left": 25,
   "right": 18,
   "top": 20,
   "bottom": 23
  }
 },
 "type": {
  "face": "serif",
  "ladder": [
   [
    11,
    14.5
   ],
   [
    10.5,
    13.8
   ],
   [
    10,
    13.2
   ]
  ],
  "align": "left"
 },
 "page_rule": {
  "kind": "flow"
 },
 "furniture": {
  "first": "none",
  "later": "header_number",
  "format": "n",
  "header": [
   "subject",
   "class_level",
   "topic"
  ]
 },
 "flow": [
  {
   "block": "doc_head",
   "part": "head",
   "fields": [
    "school",
    "kind",
    "term_and_number",
    "subject",
    "class_level",
    "topic"
   ],
   "params": {
    "overline": "school",
    "kind_line": "kind",
    "kind_default": "kind_test",
    "title": [
     "subject",
     "class_level"
    ],
    "subtitle": [
     "topic"
    ],
    "rules": "both",
    "align": "centre"
   }
  },
  {
   "block": "cell_strip",
   "part": "pupil_line",
   "when": "nofact:use=self_study",
   "params": {
    "rows": [
     [
      {
       "label": "name",
       "share": 1
      }
     ],
     [
      {
       "label": "class",
       "share": 0.3
      },
      {
       "label": "date",
       "share": 0.4
      },
      {
       "label": "score",
       "share": 0.17,
       "heavy": true,
       "total": true
      },
      {
       "label": "mark",
       "share": 0.13,
       "heavy": true
      }
     ]
    ],
    "height_mm": 10
   }
  },
  {
   "block": "line",
   "part": "instruction",
   "fields": [
    "time_min"
   ],
   "when": "nofact:use=self_study",
   "params": {
    "style": "small",
    "label": "instruction",
    "sentences": [
     "one_answer",
     "time",
     "point_each"
    ],
    "drop_empty_slots": true
   }
  },
  {
   "block": "line",
   "part": "instruction",
   "when": "fact:use=self_study",
   "params": {
    "style": "small",
    "label": "instruction",
    "sentences": [
     "self_study"
    ]
   }
  },
  {
   "block": "heading",
   "part": "part_choice",
   "when": "questions:both",
   "params": {
    "level": 2,
    "numbering": "none",
    "rule": "under",
    "label": "part_choice"
   }
  },
  {
   "block": "question_list",
   "part": "part_choice",
   "when": "questions:choice",
   "params": {
    "filter": "choice",
    "letters": true,
    "option_columns": "auto",
    "marks": false
   }
  },
  {
   "block": "callout",
   "part": "passage",
   "when": "part:passage",
   "keep": "passage",
   "params": {
    "style": "bar",
    "label": "passage"
   }
  },
  {
   "block": "question_list",
   "part": "part_choice",
   "when": "questions:passage",
   "keep": "passage",
   "params": {
    "filter": "passage",
    "letters": true,
    "option_columns": "auto",
    "marks": false
   }
  },
  {
   "block": "heading",
   "part": "part_open",
   "when": "questions:both",
   "params": {
    "level": 2,
    "numbering": "none",
    "rule": "under",
    "label": "part_open"
   }
  },
  {
   "block": "question_list",
   "part": "part_open",
   "when": "questions:open",
   "params": {
    "filter": "open",
    "answer_rows": 4,
    "marks": true
   }
  },
  {
   "block": "answer_key",
   "part": "answer_sheet",
   "when": "fact:answer_extras=answer_sheet",
   "params": {
    "style": "sheet",
    "per_row": 10,
    "label": "sheet"
   }
  },
  {
   "block": "answer_key",
   "part": "answer_key",
   "page_break_before": true,
   "params": {
    "style": "grid",
    "per_row": 10,
    "label": "key"
   }
  },
  {
   "block": "table",
   "part": "model_answers",
   "when": "questions:open",
   "params": {
    "columns": [
     {
      "label": "no",
      "width_mm": 11,
      "align": "centre"
     },
     {
      "label": "model_answer",
      "width_mm": "flex"
     },
     {
      "label": "score",
      "width_mm": 17,
      "align": "centre"
     }
    ],
    "rules": "horizontal",
    "from": "questions:open"
   }
  }
 ],
