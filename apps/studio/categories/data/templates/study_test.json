{
 "schema": 2,
 "id": "study_test",
 "entries": [
  "pdf.test"
 ],
 "name": {
  "uz": "Test varag‘i",
  "ru": "Тестовый лист",
  "en": "Test paper"
 },
 "family": "study",
 "page": {
  "margins_mm": {
   "left": 25,
   "right": 18,
   "top": 20,
   "bottom": 23
  }
 },
 "type": {
  "face": "serif",
  "ladder": [
   [
    11,
    14.5
   ],
   [
    10.5,
    13.8
   ],
   [
    10,
    13.2
   ]
  ],
  "align": "left"
 },
 "page_rule": {
  "kind": "flow"
 },
 "furniture": {
  "first": "number",
  "later": "header_number",
  "format": "n",
  "header": [
   "subject",
   "class_level",
   "topic"
  ]
 },
 "flow": [
  {
   "block": "doc_head",
   "part": "head",
   "fields": [
    "school",
    "kind",
    "term_and_number",
    "subject",
    "class_level",
    "topic"
   ],
   "params": {
    "overline": "school",
    "kind_line": "kind",
    "kind_default": "kind_test",
    "term": "term_and_number",
    "title": [
     "subject",
     "class_level"
    ],
    "subtitle": [
     "topic"
    ],
    "formats": {
     "class_level": "class_n"
    },
    "rules": "both",
    "align": "centre"
   }
  },
  {
   "block": "cell_strip",
   "part": "pupil_line",
   "when": "nofact:use=self_study",
   "params": {
    "height_mm": 10,
    "rows": [
     [
      {
       "label": "name",
       "width_mm": 167,
       "when": "nofact:pupil_identity=false"
      }
     ],
     [
      {
       "label": "class",
       "width_mm": 43,
       "when": "nofact:pupil_identity=false"
      },
      {
       "label": "date",
       "width_mm": 66,
       "when": "nofact:pupil_identity=false"
      },
      {
       "label": "score",
       "width_mm": 30,
       "gap_mm": 4,
       "heavy": true,
       "total": true,
       "when": "nofact:teacher_score=false"
      },
      {
       "label": "mark",
       "width_mm": 24,
       "heavy": true,
       "when": "nofact:teacher_score=false",
       "drop_if": {
        "fact": "kind",
        "pattern": "bsb|chsb|бсб|чсб"
       }
      }
     ]
    ]
   }
  },
  {
   "block": "question_list",
   "part": "part_choice",
   "when": "questions:choice",
   "params": {
    "filter": "choice",
    "letters": true,
    "option_columns": "auto",
    "intro": [
     {
      "when": "fact:use=self_study",
      "label": "instruction",
      "sentences": [
       "self_study"
      ]
     },
     {
      "when": [
       "fact:answer_extras=answer_sheet",
       "questions:both"
      ],
      "label": "instruction",
      "sentences": [
       "one_answer_sheet",
       "time",
       "point_each"
      ]
     },
     {
      "when": "fact:answer_extras=answer_sheet",
      "label": "instruction",
      "sentences": [
       "one_answer_sheet",
       "time",
       "point_each_one"
      ]
     },
     {
      "when": "questions:both",
      "label": "instruction",
      "sentences": [
       "one_answer",
       "time",
       "point_each"
      ]
     },
     {
      "label": "instruction",
      "sentences": [
       "one_answer",
       "time",
       "point_each_one"
      ]
     }
    ],
    "heading": {
     "label": "part_choice",
     "when": "questions:both"
    }
   }
  },
  {
   "block": "question_list",
   "part": "passage",
   "when": "questions:passage",
   "params": {
    "filter": "passage",
    "letters": true,
    "option_columns": "auto",
    "passage": {
     "part": "passage",
     "label": "passage_lead",
     "label_one": "passage_lead_one"
    }
   }
  },
  {
   "block": "question_list",
   "part": "part_open",
   "when": "questions:open",
   "params": {
    "filter": "open",
    "marks": true,
    "answer_rows": 4,
    "answer_label": "answer",
    "intro": [
     {
      "when": "fact:use=self_study",
      "label": "instruction",
      "sentences": [
       "self_study"
      ]
     },
     {
      "label": "instruction",
      "sentences": [
       "written_only",
       "time"
      ]
     }
    ],
    "heading": {
     "label": "part_open",
     "when": "questions:both"
    },
    "score": {
     "label": "score",
     "when": [
      "nofact:teacher_score=false",
      "nofact:use=self_study"
     ]
    }
   }
  },
  {
   "block": "answer_key",
   "part": "answer_sheet",
   "when": "fact:answer_extras=answer_sheet",
   "params": {
    "style": "sheet",
    "head": "plain",
    "per_row": 10,
    "label": "sheet",
    "before_pt": 18
   }
  },
  {
   "block": "answer_key",
   "part": "answer_key",
   "when": "nofact:use=self_study",
   "page_break_before": true,
   "params": {
    "style": "grid",
    "per_row": 10,
    "label": "key",
    "note": "key_note",
    "subtitle": [
     "subject",
     "class_level"
    ],
    "formats": {
     "class_level": "class_n"
    },
    "section": "key_choice",
    "total": "max_score",
    "explain_when": "fact:answer_extras=explained",
    "columns": [
     "no",
     "answer_col",
     "explanation"
    ]
   }
  },
  {
   "block": "answer_key",
   "part": "answer_key",
   "when": "fact:use=self_study",
   "page_break_before": true,
   "params": {
    "style": "explained",
    "label": "answers_self",
    "note": "self_note",
    "columns": [
     "no",
     "answer_col",
     "explanation"
    ]
   }
  },
  {
   "block": "table",
   "part": "model_answers",
   "when": "questions:open",
   "params": {
    "heading": true,
    "rules": "horizontal",
    "from": "questions:open",
    "before_pt": 14,
    "columns": [
     {
      "label": "no",
      "width_mm": 11,
      "align": "centre"
     },
     {
      "label": "model_answer",
      "width_mm": "flex"
     },
     {
      "label": "score_col",
      "width_mm": 17,
      "align": "centre"
     }
    ]
   }
  }
 ],
