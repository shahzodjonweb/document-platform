# Create the real ~/docmaster/platform/.env with scripts/deploy/init_environment.py.
# These are descriptions, NOT deployable secret values.
DEBUG=0
DEVELOPMENT_LOGIN_ENABLED=0
LOCAL_SYNC_JOBS=0
COMMERCE_SANDBOX_ENABLED=0
SECRET_KEY=
POSTGRES_PASSWORD=
FILE_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=
PUBLIC_DOMAIN=api.docmaster.live
ALLOWED_HOSTS=api.docmaster.live,docmaster.live,127.0.0.1,localhost,api
CSRF_TRUSTED_ORIGINS=https://api.docmaster.live,https://docmaster.live
TELEGRAM_WEBAPP_URL=https://docmaster.live/en/app
DOCMASTER_HTTP_PORT=8311
# Explicit activation of document processing without development sign-in.
ENABLE_DOCUMENT_TOOLS=0
# Bot waits for credentials saved through Admin Integrations.
COMPOSE_PROFILES=bot
# The new editors' switches and budgets are set in Admin → Editor; these answer only until the first save there.
# EDITOR_FLAG_EDITOR_V2=0
# EDITOR_BUDGET_RENDER_DECK=300
