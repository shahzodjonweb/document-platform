# Create the real ~/pdf-master/.env with scripts/deploy/init_environment.py.
# These are descriptions, NOT deployable secret values.
DEBUG=0
DEVELOPMENT_LOGIN_ENABLED=0
LOCAL_SYNC_JOBS=0
COMMERCE_SANDBOX_ENABLED=0
SECRET_KEY=
POSTGRES_PASSWORD=
FILE_SECRET_KEY=
INTEGRATION_ENCRYPTION_KEY=
ALLOWED_HOSTS=pdf.example.com,127.0.0.1,localhost,api
CSRF_TRUSTED_ORIGINS=https://pdf.example.com
TELEGRAM_WEBAPP_URL=https://pdf.example.com/en/app
PDFMASTER_HTTP_PORT=8310
# Explicit activation of document processing without development sign-in.
ENABLE_DOCUMENT_TOOLS=0
COMMERCE_LIVE_ENABLED=0
# Set to bot only after saving/testing credentials in Admin > Integrations.
COMPOSE_PROFILES=
