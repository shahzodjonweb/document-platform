# Copy to .env for Docker Compose, or export variables in your local shell.
# Local development only. Defaults in Python are secure/fail-closed.
DEBUG=1
SECRET_KEY=local-only-replace-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DEVELOPMENT_LOGIN_ENABLED=1
ENABLE_BETA_TOOLS=1
LOCAL_SYNC_JOBS=1
# Omit DATABASE_URL to use local SQLite.
# DATABASE_URL=postgresql://pdfmaster:your-password@localhost:5432/pdfmaster
# PRIVATE_STORAGE_ROOT=/absolute/private/storage/path
# Use a random URL-safe Fernet key in deployed environments; never commit it.
# FILE_SECRET_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=http://localhost:3000/en/app
REDIS_URL=redis://redis:6379/0
# Required for the local Compose database (create your own .env, never commit it).
POSTGRES_PASSWORD=local-development-database-only

# Bot and AI credentials may instead be saved in /ops/integrations.
# Development generates .private/integration.key automatically. Back it up with DB.
# Production: set a secret Fernet key through your secret manager.
# INTEGRATION_ENCRYPTION_KEY=
# OPENAI_API_KEY=
# AI_MODEL=
# AI_IMAGE_MODEL=
# Explicit local payment sandbox only; ignored when DEBUG=0.
COMMERCE_SANDBOX_ENABLED=1
# Live Stars activation and offer configuration: apps/commerce/README.md.
# Never enable real offers using unreviewed local fixture prices.
